{
  "rewrites": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "admin.nriclub.app" }], "destination": "/app.html" },
    { "source": "/market/:id", "missing": [{ "type": "host", "value": "admin.nriclub.app" }], "destination": "/api/preview?kind=market&id=:id" },
    { "source": "/events/:id", "missing": [{ "type": "host", "value": "admin.nriclub.app" }], "destination": "/api/preview?kind=event&id=:id" },
    { "source": "/help/:id", "missing": [{ "type": "host", "value": "admin.nriclub.app" }], "destination": "/api/preview?kind=question&id=:id" },
    { "source": "/travel/:id", "missing": [{ "type": "host", "value": "admin.nriclub.app" }], "destination": "/api/preview?kind=trip&id=:id" },
    { "source": "/(find|groups|events|help|docs|market|messages|profile|u|post|mentoring|mentors|city|guides|whats-on|travel|ambassador|impressum|terms|privacy|report)(/.*)?", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-74f0YtjU53wnK/7LG23qskD20Q5QZPKm2YZ/ExUpWpE='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://uzzkdmybsbwknpsucuvv.supabase.co; font-src 'self'; connect-src 'self' https://uzzkdmybsbwknpsucuvv.supabase.co wss://uzzkdmybsbwknpsucuvv.supabase.co; manifest-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.nriclub.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
